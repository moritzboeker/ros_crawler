# YDLidar X2 (Silicon Labs CP210x USB-UART bridge) -> stable /dev/ydlidar symlink.
# Install on the Pi host: sudo cp docker/99-crawler.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0666", GROUP:="dialout", SYMLINK+="ydlidar"
